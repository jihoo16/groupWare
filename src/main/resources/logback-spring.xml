<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 로그 저장 경로 설정 (VM 배포 시 외부 경로로 변경 가능) -->
    <property name="LOG_PATH" value="${LOG_PATH:-./logs}"/>
    <property name="LOG_FILE" value="erp-application"/>
    <property name="ERROR_LOG_FILE" value="erp-error"/>

    <!-- 로그 패턴 정의 -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="CONSOLE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>


    <!-- 콘솔 출력 설정 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 전체 로그 파일 출력 설정 (INFO 레벨 이상) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE}.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>

        <!-- 롤링 정책: 날짜별 + 파일 크기 기반 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 날짜별 백업 파일 패턴 -->
            <fileNamePattern>${LOG_PATH}/archive/${LOG_FILE}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 각 파일 최대 크기 -->
            <maxFileSize>100MB</maxFileSize>
            <!-- 보관 기간 (30일) -->
            <maxHistory>30</maxHistory>
            <!-- 전체 로그 파일 최대 용량 (10GB) -->
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>

        <!-- 로그 레벨 필터 (INFO 이상) -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- 에러 전용 로그 파일 출력 설정 (ERROR 레벨만) -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${ERROR_LOG_FILE}.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>

        <!-- 롤링 정책: 날짜별 + 파일 크기 기반 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 에러 로그 백업 파일 패턴 -->
            <fileNamePattern>${LOG_PATH}/archive/error/${ERROR_LOG_FILE}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 각 파일 최대 크기 -->
            <maxFileSize>50MB</maxFileSize>
            <!-- 보관 기간 (90일 - 에러는 더 길게 보관) -->
            <maxHistory>90</maxHistory>
            <!-- 전체 에러 로그 파일 최대 용량 (5GB) -->
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>

        <!-- ERROR 레벨만 기록 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- 비동기 로그 처리 (성능 향상) -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <appender name="ASYNC_ERROR_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="ERROR_FILE"/>
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>true</includeCallerData>
    </appender>

    <!-- 애플리케이션 로거 설정 -->
    <logger name="com.pinecni.erp" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
        <appender-ref ref="ASYNC_ERROR_FILE"/>
    </logger>

    <!-- Spring Framework 로거 설정 -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>

    <!-- Hibernate 로거 설정 -->
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.type.descriptor.sql" level="WARN"/>

    <!-- HikariCP 로거 설정 -->
    <logger name="com.zaxxer.hikari" level="INFO"/>

    <!-- Root 로거 설정 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
        <appender-ref ref="ASYNC_ERROR_FILE"/>
    </root>

</configuration>
